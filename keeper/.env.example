# ArbGuard keeper bot — environment template.
# Copy to .env and fill in. .env is gitignored: NEVER commit it, NEVER print it.
# Every variable in PHASE3-SPEC.md §1.3 is listed here.

# --- required ---
# RPC endpoint. Sepolia: https://sepolia-rollup.arbitrum.io/rpc
KEEPER_RPC_URL=
# ArbGuard address. Sepolia: 0x9D733954c71920a51291d730fc48422d94d5C306
KEEPER_GUARD_ADDRESS=
# Chain id: 421614 Sepolia, 42161 Arbitrum One, 31337 local fork.
KEEPER_CHAIN_ID=421614
# Testnet-only keeper key (0x-prefixed). Fresh key, funded with a small
# Sepolia ETH balance, registered as a keeper by the OWNER via addKeeper.
# NEVER the deployer/owner key, NEVER the fresh bounty wallet (0xc7ba…),
# NEVER the compromised wallet (0x5978…). Required in live mode; optional
# in dry-run (dry-run must work before the keeper is registered).
KEEPER_PRIVATE_KEY=

# --- watched policies ---
# Comma-separated policy ids. Sepolia: 0 (GuardedVault), 1 (GuardedPool).
KEEPER_POLICY_IDS=0,1
# First block for event scans. Sepolia deploy block: 331084418
# (ArbGuard creation tx 0x37b7e8c8ecdf22d0f96862e6c61a91684eb2261b1768398325ba95c93e68fec1).
KEEPER_DEPLOY_BLOCK=331084418

# --- polling / mode ---
# Poll interval in seconds. Range 10–300. Default 30.
KEEPER_POLL_SECONDS=30
# Default true. When true the bot logs what it WOULD do and sends nothing.
# Live mode requires explicitly setting KEEPER_DRY_RUN=false.
KEEPER_DRY_RUN=true
# Default false. When false the bot may throttle but never trip, even if a
# trip rule fires — it logs TRIP_BLOCKED_BY_CONFIG instead.
KEEPER_ALLOW_TRIP=false
# Duration passed to throttle(), seconds. Range 3600–604800. Default 86400 (24h).
# 0 (indefinite) is rejected: a bot throttle must always expire on its own.
KEEPER_THROTTLE_SECONDS=86400

# --- trigger thresholds (PHASE3-SPEC.md §1.4) ---
# T1: hour-window burn threshold, percent of hour cap. Range 50–95. Default 80.
KEEPER_HOUR_USE_PCT=80
# T2: day-window burn threshold, percent of day cap. Range 50–95. Default 80.
KEEPER_DAY_USE_PCT=80
# T3: one CheckPassed amountOut as percent of the block cap. Range 25–90. Default 50.
KEEPER_LARGE_PASS_PCT=50
# T4: consecutive failed getReferencePrice polls before acting. Range 1–10,
# or 0 to DISABLE. Default 3. Sepolia: MUST be 0 — the ETH/USD feed is stale
# by design, so the price probe never succeeds there (see RUNBOOK.md).
KEEPER_ORACLE_FAIL_POLLS=0

# --- one-shot manual trip (R3) ---
# Run the bot once with KEEPER_TRIP_ONCE=<policyId> to trip that policy and
# exit. Only trip path that does not need two signals. Still honours
# KEEPER_DRY_RUN (logs WOULD_TRIP and sends nothing when true).
# KEEPER_TRIP_ONCE=

# --- decisions log ---
# Append-only JSON decisions log, relative to keeper/. Default decisions.log.
KEEPER_LOG_FILE=decisions.log

# --- context addresses (optional; balances are context only, never triggers) ---
# Token + vault/pool addresses for the per-cycle balance context reads and
# for R1's unguarded-control comparison. Sepolia values:
# KEEPER_MWETH_ADDRESS=0x67984d4a140b32f782A53A76Ba94C1E2aFED299d
# KEEPER_MUSDC_ADDRESS=0xF280b7003291045b114937Cd2CFF3FA502bBAe72
# KEEPER_GUARDED_VAULT_ADDRESS=0xEa182E47829D76569dc50CcADD2bFafe462A0E3D
# KEEPER_UNGUARDED_VAULT_ADDRESS=0x68510BE7104F72a40e14ba72dCB2362c5a315148
# KEEPER_GUARDED_POOL_ADDRESS=0x3b1714FE7583789C10528dD43Dbb18729269679E
# KEEPER_UNGUARDED_POOL_ADDRESS=0x374049DF4b73B381E530805182F94D2cDf0F6826
