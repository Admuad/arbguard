# ArbGuard web frontend — environment variables.
# Copy to .env.local for local dev:  cp .env.example .env.local
# On Vercel, set the same names in the dashboard (Project Settings →
# Environment Variables). No real values here — all blank placeholders.
# NEVER commit .env.local or any real address/key.

# WalletConnect project ID (free at https://cloud.walletconnect.com).
# Without it the app builds but wallet connection will not work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chain the app talks to: 31337 (local Anvil) | 421614 (Arbitrum Sepolia) | 42161 (Arbitrum One).
NEXT_PUBLIC_CHAIN_ID=

# RPC endpoint. Local Anvil default: http://127.0.0.1:8545 | Sepolia: https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL=

# ArbGuard contract address. Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy (see docs/DEPLOY-CHECKLIST.md).
NEXT_PUBLIC_ARB_GUARD_ADDRESS=

# Demo vault (guarded). Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_GUARDED_VAULT_ADDRESS=

# Demo vault (unguarded control). Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_UNGUARDED_VAULT_ADDRESS=

# Demo pool (guarded). Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_GUARDED_POOL_ADDRESS=

# Demo pool (unguarded control). Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_UNGUARDED_POOL_ADDRESS=

# Attacker helper contract (runs the drain / price-push demo). Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_ATTACKER_ADDRESS=

# Mock WETH token address. Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_MWETH_ADDRESS=

# Mock USDC token address. Local Anvil: from the Anvil demo deploy output | Sepolia: from the real deploy.
NEXT_PUBLIC_MUSDC_ADDRESS=

# First block to scan for ArbGuard events ("earliest" = from genesis; or a block number to start at). Default "earliest".
NEXT_PUBLIC_DEPLOY_BLOCK=
